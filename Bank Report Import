/**
 * ГЕНЕРИЧНИЙ АЛГОРИТМ ДЛЯ OTP БАНКУ
 * Абстрагує розбіжності між гривневими та валютними виписками, проводячи семантичний аналіз дебет/кредит.
 * @param {string} sourceSheetName - Аркуш-джерело виписки
 * @param {string} targetSheetName - Цільовий аркуш операційного журналу
 */
function importOtpGeneric(sourceSheetName, targetSheetName) {
  const ui = SpreadsheetApp.getUi();
  try {
    const sourceSpreadsheet = SpreadsheetApp.openById(SOURCE_FILE_ID);
    const targetSpreadsheet = SpreadsheetApp.openById(TARGET_FILE_ID);
    
    const sourceSheet = sourceSpreadsheet.getSheetByName(sourceSheetName);
    const targetSheet = targetSpreadsheet.getSheetByName(targetSheetName);
    
    if (!sourceSheet || !targetSheet) return;
    const sourceLastRow = sourceSheet.getLastRow();
    if (sourceLastRow < 6) return;
    
    const channelName = getChannelNameFromTarget(targetSheet);
    
    const sourceData = sourceSheet.getRange(6, 1, sourceLastRow - 5, 12).getValues();
    const sourceDisplayDates = sourceSheet.getRange(6, 10, sourceLastRow - 5, 1).getDisplayValues();
    
    const targetLastRow = targetSheet.getLastRow();
    const targetIdMap = new Map();
    if (targetLastRow >= 9) {
      const targetIds = targetSheet.getRange(9, 2, targetLastRow - 8, 1).getValues();
      targetIds.forEach((row, idx) => {
        if (row[0]) targetIdMap.set(row[0].toString().trim(), 9 + idx);
      });
    }
    
    let updatedCount = 0;
    const rowsToInsert = [];
    const localProcessedIds = new Set();
    
    sourceData.forEach((row, index) => {
      const docNum = row[10] ? row[10].toString().trim() : ""; 
      if (!docNum || localProcessedIds.has(docNum)) return;
      localProcessedIds.add(docNum);
      
      const rawDateStr = sourceDisplayDates[index][0];
      let dateVal = parseStrictUkranianDate(rawDateStr);
      
      const type = row[2] ? row[2].toString().trim().toLowerCase() : ""; 
      const contraparty = row[6]; 
      const purpose = row[8]; 
      const amount = parseFloat(row[11]) || 0; 
      
      // Семантичний розподіл Напрямку Грошей (Inflow/Outflow)
      let inflow = 0; let outflow = 0;
      if (type === "кредит" || type === "credit") inflow = amount;
      else if (type === "дебет" || type === "debit") outflow = amount;
      else { 
        if (amount > 0) inflow = amount; else outflow = Math.abs(amount); 
      }
      
      const rowData = [dateVal, docNum, contraparty, purpose, inflow, outflow, "", "", "", "", channelName];
      
      if (targetIdMap.has(docNum)) {
        const targetRowNumber = targetIdMap.get(docNum);
        targetSheet.getRange(targetRowNumber, 1, 1, 11).setValues([rowData]);
        updatedCount++;
      } else {
        rowsToInsert.push(rowData);
      }
    });
    
    if (rowsToInsert.length > 0) {
      const startRow = targetSheet.getLastRow() < 9 ? 9 : targetSheet.getLastRow() + 1;
      targetSheet.getRange(startRow, 1, rowsToInsert.length, 11).setValues(rowsToInsert);
    }
    
    ui.alert(`✅ ${targetSheetName} оброблено:\n• Код каналу: ${channelName}\n• Оновлено записів: ${updatedCount}\n• Додано нових: ${rowsToInsert.length}`);
  } catch (error) {
    ui.alert("❌ Помилка: " + error.toString());
  }
}
